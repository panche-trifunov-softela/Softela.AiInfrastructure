{
  "id": "memory-as-context",
  "title": "Memory as context",
  "summary": "Durable project knowledge on disk, injected at session start, so context survives compaction and session loss.",
  "defaultEnabled": true,
  "requires": [],
  "guards": [],
  "prompt": "prompt.md",
  "files": [
    {
      "from": "hooks/inject-memory.js",
      "to": "hooks/inject-memory.js"
    },
    {
      "from": "hooks/guard-memory.js",
      "to": "hooks/guard-memory.js"
    },
    {
      "from": "hooks/memory-autocommit.js",
      "to": "hooks/memory-autocommit.js"
    },
    {
      "from": "hooks/memory-location.js",
      "to": "hooks/memory-location.js"
    },
    {
      "from": "hooks/compact-checkpoint.js",
      "to": "hooks/compact-checkpoint.js"
    },
    {
      "from": "hooks/transcript.js",
      "to": "hooks/transcript.js"
    },
    {
      "from": "hooks/stdin.js",
      "to": "hooks/stdin.js"
    },
    {
      "from": "hooks/seed-memory.js",
      "to": "hooks/seed-memory.js"
    },
    {
      "from": "hooks/git-commit.js",
      "to": "hooks/git-commit.js"
    },
    {
      "from": "ACTIVE-WORK.tmpl.md",
      "to": "ACTIVE-WORK.tmpl.md"
    },
    {
      "from": "seed/browser-debugging.md",
      "to": "seed/browser-debugging.md"
    },
    {
      "from": "seed/bugworx-architecture.md",
      "to": "seed/bugworx-architecture.md"
    },
    {
      "from": "seed/bugworx-editable-form-context.md",
      "to": "seed/bugworx-editable-form-context.md"
    },
    {
      "from": "seed/bugworx-imports.md",
      "to": "seed/bugworx-imports.md"
    },
    {
      "from": "seed/bugworx-no-typescript.md",
      "to": "seed/bugworx-no-typescript.md"
    },
    {
      "from": "seed/bugworx-verification-trap.md",
      "to": "seed/bugworx-verification-trap.md"
    },
    {
      "from": "seed/code-documentation-style.md",
      "to": "seed/code-documentation-style.md"
    },
    {
      "from": "seed/delegation-model-roles.md",
      "to": "seed/delegation-model-roles.md"
    },
    {
      "from": "seed/frontend-types-mirror-backend.md",
      "to": "seed/frontend-types-mirror-backend.md"
    },
    {
      "from": "seed/ignore-repo-instruction-files.md",
      "to": "seed/ignore-repo-instruction-files.md"
    },
    {
      "from": "seed/keep-memory-synced-with-code.md",
      "to": "seed/keep-memory-synced-with-code.md"
    },
    {
      "from": "seed/memory-as-working-context.md",
      "to": "seed/memory-as-working-context.md"
    },
    {
      "from": "seed/memory-authority-model.md",
      "to": "seed/memory-authority-model.md"
    },
    {
      "from": "seed/pr-splitting-a-branch.md",
      "to": "seed/pr-splitting-a-branch.md"
    },
    {
      "from": "seed/session-cleanup.md",
      "to": "seed/session-cleanup.md"
    },
    {
      "from": "seed/softela-git-flow.md",
      "to": "seed/softela-git-flow.md"
    },
    {
      "from": "seed/subagents-must-not-bypass-guards.md",
      "to": "seed/subagents-must-not-bypass-guards.md"
    },
    {
      "from": "seed/test-entity-naming.md",
      "to": "seed/test-entity-naming.md"
    }
  ],
  "hooks": [
    {
      "agent": "claude",
      "event": "SessionStart",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "codex",
      "event": "SessionStart",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "codex",
      "event": "PostCompact",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "claude",
      "event": "PreToolUse",
      "matcher": "Write|Edit|Bash|PowerShell|shell|local_shell|exec_command|shell_command",
      "command": "{{NODE}} {{INSTALLED}}/hooks/guard-memory.js --agent=claude --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "codex",
      "event": "PreToolUse",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/guard-memory.js --agent=codex --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "claude",
      "event": "PostToolUse",
      "matcher": "Write|Edit",
      "command": "{{NODE}} {{INSTALLED}}/hooks/memory-autocommit.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "codex",
      "event": "PostToolUse",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/memory-autocommit.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}"
    },
    {
      "agent": "claude",
      "event": "PreCompact",
      "matcher": "manual|auto",
      "command": "{{NODE}} {{INSTALLED}}/hooks/compact-checkpoint.js --agent=claude --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}} --checkpoint={{OPT_CHECKPOINT}}"
    },
    {
      "agent": "codex",
      "event": "PreCompact",
      "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/compact-checkpoint.js --agent=codex --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}} --checkpoint={{OPT_CHECKPOINT}}"
    }
  ],
  "settings": [],
  "options": {
    "location": {
      "type": "enum",
      "values": [
        "repo",
        "infrastructure",
        "global"
      ],
      "default": "global",
      "prompt": "Where should memory live — the agent's own global memory directory, shared with whatever the developer already keeps there (default) · a per-project folder inside this tool's own directory · or inside the product repository itself (git-ignored)?"
    },
    "checkpoint": {
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "on",
      "prompt": "Before a compaction (manual or automatic) drops conversation history, save a checkpoint of everything the developer themselves typed, verbatim?"
    }
  }
}
