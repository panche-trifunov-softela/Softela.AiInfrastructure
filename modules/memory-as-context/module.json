{
  "id": "memory-as-context",
  "title": "Memory as context",
  "summary": "Durable project knowledge on disk, injected at session start, so context survives compaction and session loss.",
  "defaultEnabled": true,
  "requires": [],
  "guards": [],
  "prompt": "prompt.md",
  "files": [
    { "from": "hooks/inject-memory.js", "to": "hooks/inject-memory.js" },
    { "from": "hooks/guard-memory.js", "to": "hooks/guard-memory.js" },
    { "from": "hooks/memory-autocommit.js", "to": "hooks/memory-autocommit.js" },
    { "from": "hooks/memory-location.js", "to": "hooks/memory-location.js" },
    { "from": "hooks/compact-checkpoint.js", "to": "hooks/compact-checkpoint.js" },
    { "from": "hooks/transcript.js", "to": "hooks/transcript.js" },
    { "from": "hooks/stdin.js", "to": "hooks/stdin.js" },
    { "from": "hooks/seed-memory.js", "to": "hooks/seed-memory.js" },
    { "from": "hooks/git-commit.js", "to": "hooks/git-commit.js" },
    { "from": "ACTIVE-WORK.tmpl.md", "to": "ACTIVE-WORK.tmpl.md" },
    { "from": "seed/backend-architecture.md", "to": "seed/backend-architecture.md" },
    { "from": "seed/backend-building-blocks.md", "to": "seed/backend-building-blocks.md" },
    { "from": "seed/backend-screens-appcomponents.md", "to": "seed/backend-screens-appcomponents.md" },
    { "from": "seed/browser-debugging.md", "to": "seed/browser-debugging.md" },
    { "from": "seed/code-documentation-style.md", "to": "seed/code-documentation-style.md" },
    { "from": "seed/delegation-model-roles.md", "to": "seed/delegation-model-roles.md" },
    { "from": "seed/frontend-api.md", "to": "seed/frontend-api.md" },
    { "from": "seed/frontend-architecture.md", "to": "seed/frontend-architecture.md" },
    { "from": "seed/frontend-code-placement.md", "to": "seed/frontend-code-placement.md" },
    { "from": "seed/frontend-dependency-install.md", "to": "seed/frontend-dependency-install.md" },
    { "from": "seed/frontend-editors-sync.md", "to": "seed/frontend-editors-sync.md" },
    { "from": "seed/frontend-export-action.md", "to": "seed/frontend-export-action.md" },
    { "from": "seed/frontend-hooks.md", "to": "seed/frontend-hooks.md" },
    { "from": "seed/frontend-render-tree.md", "to": "seed/frontend-render-tree.md" },
    { "from": "seed/frontend-state-stores.md", "to": "seed/frontend-state-stores.md" },
    { "from": "seed/frontend-test-run-resource-cap.md", "to": "seed/frontend-test-run-resource-cap.md" },
    { "from": "seed/frontend-typecheck-gotcha.md", "to": "seed/frontend-typecheck-gotcha.md" },
    { "from": "seed/frontend-types-mirror-backend.md", "to": "seed/frontend-types-mirror-backend.md" },
    { "from": "seed/frontend-types.md", "to": "seed/frontend-types.md" },
    { "from": "seed/frontend-utils-helpers.md", "to": "seed/frontend-utils-helpers.md" },
    { "from": "seed/frontend-vocabulary-i18n.md", "to": "seed/frontend-vocabulary-i18n.md" },
    { "from": "seed/ignore-repo-instruction-files.md", "to": "seed/ignore-repo-instruction-files.md" },
    { "from": "seed/keep-memory-synced-with-code.md", "to": "seed/keep-memory-synced-with-code.md" },
    { "from": "seed/softela-domain-entities.md", "to": "seed/softela-domain-entities.md" },
    { "from": "seed/softela-git-flow.md", "to": "seed/softela-git-flow.md" },
    { "from": "seed/softela-reference-exports.md", "to": "seed/softela-reference-exports.md" },
    { "from": "seed/memory-as-working-context.md", "to": "seed/memory-as-working-context.md" },
    { "from": "seed/memory-authority-model.md", "to": "seed/memory-authority-model.md" },
    { "from": "seed/nonce-guarded-effect-hook.md", "to": "seed/nonce-guarded-effect-hook.md" },
    { "from": "seed/pr-splitting-a-branch.md", "to": "seed/pr-splitting-a-branch.md" },
    { "from": "seed/product-config-model.md", "to": "seed/product-config-model.md" },
    { "from": "seed/product-integration-identity.md", "to": "seed/product-integration-identity.md" },
    { "from": "seed/scexpert-design-tokens.md", "to": "seed/scexpert-design-tokens.md" },
    { "from": "seed/session-cleanup.md", "to": "seed/session-cleanup.md" },
    { "from": "seed/subagents-must-not-bypass-guards.md", "to": "seed/subagents-must-not-bypass-guards.md" },
    { "from": "seed/test-entity-naming.md", "to": "seed/test-entity-naming.md" },
    { "from": "seed/wms-domain-primer.md", "to": "seed/wms-domain-primer.md" }
  ],
  "hooks": [
    { "agent": "claude", "event": "SessionStart", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },
    { "agent": "codex", "event": "SessionStart", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },
    { "agent": "codex", "event": "PostCompact", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-memory.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },

    { "agent": "claude", "event": "PreToolUse", "matcher": "Write|Edit|Bash|PowerShell|shell|local_shell|exec_command|shell_command",
      "command": "{{NODE}} {{INSTALLED}}/hooks/guard-memory.js --agent=claude --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },
    { "agent": "codex", "event": "PreToolUse", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/guard-memory.js --agent=codex --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },

    { "agent": "claude", "event": "PostToolUse", "matcher": "Write|Edit",
      "command": "{{NODE}} {{INSTALLED}}/hooks/memory-autocommit.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },
    { "agent": "codex", "event": "PostToolUse", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/memory-autocommit.js --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}}" },

    { "agent": "claude", "event": "PreCompact", "matcher": "manual|auto",
      "command": "{{NODE}} {{INSTALLED}}/hooks/compact-checkpoint.js --agent=claude --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}} --checkpoint={{OPT_CHECKPOINT}}" },
    { "agent": "codex", "event": "PreCompact", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/compact-checkpoint.js --agent=codex --agent-home={{AGENT_HOME}} --location={{OPT_LOCATION}} --checkpoint={{OPT_CHECKPOINT}}" }
  ],
  "settings": [],
  "options": {
    "location": {
      "type": "enum",
      "values": ["repo", "infrastructure", "global"],
      "default": "global",
      "prompt": "Where should memory live — the agent's own global memory directory, shared with whatever the developer already keeps there (default) · a per-project folder inside this tool's own directory · or inside the product repository itself (git-ignored)?"
    },
    "checkpoint": {
      "type": "enum",
      "values": ["on", "off"],
      "default": "on",
      "prompt": "Before a compaction (manual or automatic) drops conversation history, save a checkpoint of everything the developer themselves typed, verbatim?"
    }
  }
}
