{
  "id": "analyze-first",
  "title": "Analyze first",
  "summary": "Read before writing, state assumptions, and ask instead of guessing when a request is genuinely ambiguous.",
  "defaultEnabled": true,
  "requires": [],
  "guards": [],
  "files": [
    { "from": "hooks/inject-plan-gate.js", "to": "hooks/inject-plan-gate.js" },
    { "from": "hooks/analyze-first-core-lib.js", "to": "hooks/analyze-first-core-lib.js" }
  ],
  "hooks": [
    { "agent": "claude", "event": "UserPromptSubmit", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-plan-gate.js" },
    { "agent": "codex", "event": "UserPromptSubmit", "matcher": null,
      "command": "{{NODE}} {{INSTALLED}}/hooks/inject-plan-gate.js" }
  ],
  "settings": [],
  "options": {}
}
