{
  "$schema": "../core/schema/project.schema.json",
  "id": "Softela.ReactSCExpert",
  "stack": "frontend",
  "match": {
    "remotes": ["*/Softela.ReactSCExpert"]
  },
  "baseBranches": ["dev-ng"],
  "releaseBranchPattern": "^releases/",
  "branchNaming": {
    "pattern": "^(feature|bugfix|fix|hotfix)/((task|ticket)[_-])?\\d+[_-].+$",
    "action": "ask",
    "preferred": "feature/task_00000_short_name"
  },
  "localConfig": [
    {
      "tracked": "public/config.js",
      "perMachine": "public/config.development.js",
      "action": "ask",
      "allowedLines": ["^\\s*const\\s+LOCAL_[A-Z_]+_ORIGIN\\s*="],
      "switches": ["\\bUSE_LOCAL_API\\s*=\\s*true\\b"],
      "reason": "public/config.js is tracked, and USE_LOCAL_API guards a local target by convention alone — this repository has not adopted a per-machine config file, so the deployed value must be restored before anything is staged"
    }
  ],
  "notOurs": ["cypress/**"],
  "commands": {
    "typecheck": {
      "deny": "\\btsc\\s+--noEmit(?!.*(-p\\b|--project\\b|-b\\b))",
      "fix": "npx tsc -b",
      "reason": "the root tsconfig is a solution file with files:[] — a bare --noEmit checks nothing and exits 0"
    },
    "install": {
      "deny": "\\bnpm\\s+(install|i|add)\\b(?!.*(--force|--legacy-peer-deps))",
      "fix": "npm i --force",
      "reason": "peer conflicts break the install otherwise"
    },
    "forbidden": [
      {
        "pattern": "\\bcypress\\s+(run|open)\\b",
        "action": "deny",
        "reason": "cypress/e2e is owned by the QA team"
      }
    ]
  },
  "memoryLocation": "infrastructure"
}
